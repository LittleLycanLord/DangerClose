# =============================================================================
# Unreal Engine .gitignore
# =============================================================================
# USAGE:
#   1. Move this file to the root of your repository.
#   2. Rename it from "Unreal.gitignore" to ".gitignore".
#   3. Delete the Gitignores/ folder (it is no longer needed).
# =============================================================================

# -----------------------------------------------------------------------------
# Unreal Engine build & intermediate output folders
# These are always generated locally by the build system (Unreal Build Tool).
# "Intermediate/" and "DerivedDataCache/" can be extremely large (multi-GB)
# and are fully reconstructed by UBT / the Editor on first build/launch.
# "Binaries/" contains compiled game/plugin binaries — large and environment-
# specific, so they are excluded even though they are required to run the game.
# Commit them only if you have a specific reason (e.g. no CI build server).
# -----------------------------------------------------------------------------
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# -----------------------------------------------------------------------------
# Plugins — binaries only
# Commit your plugin source (Plugins/MyPlugin/Source/), but not their compiled
# output.  The pattern below excludes Binaries inside any plugin folder while
# keeping the source tree.
# -----------------------------------------------------------------------------
Plugins/*/Binaries/
Plugins/*/Intermediate/

# -----------------------------------------------------------------------------
# Visual Studio / Visual Studio Code solution & database files
# UBT regenerates these; committing them creates conflicts between developers.
# -----------------------------------------------------------------------------
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/
.vscode/

# -----------------------------------------------------------------------------
# Unreal Engine source distribution
# If you installed UE from source, the Engine/ directory is enormous and should
# never be committed — reference the engine path via the .uproject file instead.
# -----------------------------------------------------------------------------
Engine/

# -----------------------------------------------------------------------------
# Compiled shader cache
# Shaders are recompiled per-machine and stored in DerivedDataCache/,
# but standalone .ushaderbytecode files may also appear here.
# -----------------------------------------------------------------------------
*.ushaderbytecode
*.metallib

# -----------------------------------------------------------------------------
# Packed / cooked build output
# These are the distributable game files produced by the packaging step.
# They are large binaries and should live in a separate deployment repository
# or artifact store, not in source control.
# -----------------------------------------------------------------------------
*.pak
*.sig
*.ucas
*.utoc

# -----------------------------------------------------------------------------
# Hot-reload helper files produced by the live coding system
# -----------------------------------------------------------------------------
*.exp
*.lib
*.pdb

# -----------------------------------------------------------------------------
# Crash dumps & diagnostic reports
# Auto-generated by Unreal's crash reporter; not useful in version control.
# -----------------------------------------------------------------------------
Saved/Crashes/
Saved/Logs/
*.dmp
*.log

# -----------------------------------------------------------------------------
# macOS metadata
# .DS_Store = macOS folder metadata
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# -----------------------------------------------------------------------------
# Windows thumbnail cache
# -----------------------------------------------------------------------------
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Xcode (iOS / macOS builds)
# -----------------------------------------------------------------------------
*.xcworkspace
*.xcodeproj
xcuserdata/

# -----------------------------------------------------------------------------
# Android build artifacts
# -----------------------------------------------------------------------------
*.apk
*.aab

# -----------------------------------------------------------------------------
# JetBrains Rider
# -----------------------------------------------------------------------------
.idea/
