# =============================================================================
# Unity .gitignore
# =============================================================================
# USAGE:
#   1. Move this file to the root of your repository.
#   2. Rename it from "Unity.gitignore" to ".gitignore".
#   3. Delete the Gitignores/ folder (it is no longer needed).
# =============================================================================

# -----------------------------------------------------------------------------
# Unity-generated folders
# These directories are auto-generated by Unity and do not need to be tracked.
# "Library/" is especially important — it can be very large and is always
# rebuilt from the Assets/ folder by Unity on first open.
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
/[Uu]ser[Ss]ettings/

# -----------------------------------------------------------------------------
# Build output folders
# Unity places platform-specific build artifacts here.
# These are often large binary files that should not be committed.
# -----------------------------------------------------------------------------
/[Bb]uild/
/[Bb]uilds/

# -----------------------------------------------------------------------------
# Auto-generated Visual Studio / Rider solution & project files
# Unity regenerates these automatically, so committing them causes
# unnecessary conflicts between team members using different IDEs.
# -----------------------------------------------------------------------------
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/

# -----------------------------------------------------------------------------
# Unity Addressables (streaming assets / asset bundles)
# The local build cache for Addressable Assets is machine-specific.
# NOTE: You MAY want to commit AddressableAssetsData/ itself (the settings),
# but NOT the aa/ sub-folder that contains built content.
# -----------------------------------------------------------------------------
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/**/*.bin*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/**/*.json
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/**/*.tmp

# -----------------------------------------------------------------------------
# Asset Store legacy folder
# The old Asset Store download cache; not part of your project source.
# -----------------------------------------------------------------------------
/[Aa]ssets/[Aa]sset[Ss]tore-5.x

# -----------------------------------------------------------------------------
# Crash & diagnostic reports
# Auto-generated; not useful in version control.
# -----------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties

# -----------------------------------------------------------------------------
# Build artifacts & packaged output
# .apk  = Android application package
# .aab  = Android App Bundle (Play Store upload format)
# .unitypackage = Unity-specific package export
# .app  = macOS application bundle
# -----------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# -----------------------------------------------------------------------------
# Operating system & editor metadata
# .DS_Store = macOS folder metadata
# Thumbs.db = Windows thumbnail cache
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# JetBrains Rider
# -----------------------------------------------------------------------------
.idea/
*.rider.unity

# -----------------------------------------------------------------------------
# Plastic SCM (if you ever switch VCS, exclude its workspace metadata)
# -----------------------------------------------------------------------------
/[Aa]ssets/[Pp]lastic_[Ss]cm/
